PORT=3000
# Brevo is the primary provider. Create a v3 API key in Brevo under
# SMTP & API -> API Keys, and verify the sender address under Senders.
BREVO_API_KEY=your-brevo-v3-api-key
MAIL_FROM="Receipt Desk <your-verified-sender@example.com>"

# Optional SMTP fallback. Keep this empty when maintaining Brevo only.
# FALLBACK_SMTP_HOST=smtp-relay.brevo.com
# FALLBACK_SMTP_PORT=587
# FALLBACK_SMTP_SECURE=false
# FALLBACK_SMTP_USER=your-brevo-smtp-login
# FALLBACK_SMTP_PASS=your-brevo-smtp-key
# FALLBACK_MAIL_FROM="Receipt Desk <your-verified-sender@example.com>"
