PORT=3000
# Gmail: use smtp.gmail.com with a 16-character Google app password.
# Do not use the normal Gmail account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-google-app-password
MAIL_FROM="Receipt Desk <your-gmail-address@gmail.com>"

# Optional independent backup SMTP provider. It is used when primary SMTP
# authentication is rejected, so do not point it at the same Gmail account.
# FALLBACK_SMTP_HOST=smtp.example.com
# FALLBACK_SMTP_PORT=587
# FALLBACK_SMTP_SECURE=false
# FALLBACK_SMTP_USER=your-backup-smtp-user
# FALLBACK_SMTP_PASS=your-backup-smtp-password
# FALLBACK_MAIL_FROM="Receipt Desk <verified-sender@example.com>"
